# Configuracion no sensible. Copia este archivo como .env para desarrollo local.
APP_ENV=development
LOG_LEVEL=INFO

# Valores exclusivos para el contenedor local. No los reutilices fuera del desarrollo.
POSTGRES_DB=fde_customers
POSTGRES_USER=fde_app
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55433
DATABASE_URL=postgresql://fde_app:local-development-only@localhost:55433/fde_customers
# Dentro de Compose se usa el nombre del servicio. Solo el piloto local comparte credenciales
# entre aplicacion y migrador; un entorno real debe asignar cuentas con privilegios distintos.
CONTAINER_DATABASE_URL=postgresql://fde_app:local-development-only@database:5432/fde_customers
MIGRATION_DATABASE_URL=postgresql://fde_app:local-development-only@database:5432/fde_customers
POSTGRES_TEST_PORT=55434
TEST_DATABASE_URL=postgresql://fde_test:test-only-password@localhost:55434/fde_test
# En un ambiente administrado, omite el valor directo y usa JWT_SECRET_FILE/IDENTIFIER_HASH_KEY_FILE.
JWT_SECRET=local-jwt-signing-key-change-before-any-shared-environment
IDENTIFIER_HASH_KEY=local-identifier-hash-key-change-before-any-shared-environment
METRICS_TOKEN=local-metrics-token-change-before-any-shared-environment
JWT_ISSUER=fde-local
JWT_AUDIENCE=fde-import-api
API_HOST=127.0.0.1
API_PORT=8000
API_PUBLIC_PORT=8000

# IA (Fase 4). OPENAI_API_KEY es opcional hasta invocar un endpoint de IA.
# No guardes una clave real aqui. En ambientes compartidos usa OPENAI_API_KEY_FILE.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=500
# Configura precios vigentes por millon de tokens para habilitar el costo estimado.
# Se dejan vacios deliberadamente para no fijar precios que pueden cambiar.
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
EMBEDDING_PROVIDER=deterministic_local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256

# Integracion simulada. Estos secretos son solo para desarrollo local.
# En un ambiente administrado, omite el valor directo y usa PARTNER_WEBHOOK_SECRET_FILE.
PARTNER_WEBHOOK_SECRET=local-partner-webhook-secret-change-before-shared-environment
PARTNER_WEBHOOK_URL=http://partner_api:8001/partner/v1/import-events
PARTNER_API_PORT=8001
PARTNER_PUBLIC_PORT=8001
PARTNER_SIMULATED_FAILURES=1
INTEGRATION_TIMEOUT_MS=2000
INTEGRATION_MAX_ATTEMPTS=5
INTEGRATION_BASE_BACKOFF_SECONDS=1
INTEGRATION_MAX_BACKOFF_SECONDS=30
INTEGRATION_LEASE_SECONDS=30
INTEGRATION_POLL_SECONDS=0.25
