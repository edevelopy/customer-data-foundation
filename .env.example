# Configuracion no sensible. Copia este archivo como .env para desarrollo local.
APP_ENV=development
LOG_LEVEL=INFO

# Valores exclusivos para el contenedor local. No los reutilices fuera del desarrollo.
POSTGRES_DB=fde_customers
POSTGRES_USER=fde_app
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55433
DATABASE_URL=postgresql://fde_app:local-development-only@localhost:55433/fde_customers
